# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Melodia
ENVIRONMENT=development
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=melodia
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=melodia
DATABASE_URL=postgresql+asyncpg://melodia:change-me-db-password@localhost:5432/melodia

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Music Provider ────────────────────────────────────────────────────────────
# Options: deezer | mock
MUSIC_PROVIDER=deezer
# Deezer public API requires no key for basic endpoints
DEEZER_API_BASE_URL=https://api.deezer.com

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: console | json
LOG_FORMAT=console

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
